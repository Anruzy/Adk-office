# Configuración central de Adk-office (Office Móvil).
# Los scripts de scripts/ y el flujo de GitHub Actions leen este archivo.
# Cualquier variable se puede sobrescribir desde el entorno.

# --- Código fuente (monorepo oficial de Collabora Office, MPL-2.0) ---------
# El motor (antes "LibreOffice core") vive en engine/ dentro del monorepo.
: "${COLLABORA_REPO:=https://gerrit.collaboraoffice.com/online}"
: "${TRANSLATIONS_REPO:=https://gerrit.collaboraoffice.com/translations}"
# Rama, etiqueta o commit a compilar. Para builds reproducibles fija aquí un
# commit concreto (el último usado queda registrado en FUENTES.txt del build).
: "${COLLABORA_REF:=main}"

# --- Destino ---------------------------------------------------------------
# arm64-v8a cubre prácticamente todos los celulares actuales.
# Otras opciones: armeabi-v7a, x86_64, x86.
: "${ANDROID_ABI:=arm64-v8a}"
# NDK con el que se compila el motor (requiere 27 o superior).
: "${NDK_ENGINE_VERSION:=29.0.14206865}"
# Idiomas de la interfaz. en-US siempre se incluye.
: "${ADK_LANGS:=en-US es}"

# --- Identidad de la app -----------------------------------------------------
: "${APP_NAME:=Office Móvil}"
# Nombre (sin acentos ni espacios) de los archivos APK generados.
: "${APP_FILE_NAME:=Office-Movil}"
: "${APP_PACKAGE:=io.github.anruzy.adkoffice}"
: "${APP_VENDOR:=Adk-office}"
: "${APP_INFO_URL:=https://github.com/anruzy/Adk-office}"

# --- Directorios de trabajo --------------------------------------------------
# Todo lo pesado (código ~3 GB, compilación ~25-35 GB) va aquí.
: "${ADK_WORK:=$ADK_ROOT/work}"
: "${ADK_SRC:=$ADK_WORK/collabora-office}"
# Paquetes externos que descarga el motor (se reaprovechan entre builds).
: "${ADK_TARBALLS:=$ADK_WORK/tarballs}"
: "${ADK_OUT:=$ADK_ROOT/out}"
